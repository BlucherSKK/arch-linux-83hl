# Оверрайды поверх конфига ядра.
#
# По умолчанию берётся arch/arm64/configs/ubuntu_x1e_defconfig из
# jglathe/linux_ms_dev_kit — это тот самый конфиг, на котором у людей
# работает Slim 5x (Wi-Fi, GPU, звук, suspend). Здесь только то, что
# нужно поменять для нашей сборки.
#
# Если собирать с обычным defconfig (KDEFCONFIG=defconfig), блок
# "страховка" внизу включает минимум для X1P42100.

# --- идентификация сборки ------------------------------------------------
CONFIG_LOCALVERSION="-83hl"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- без debug info: быстрее сборка и меньше модули ----------------------
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set

# --- не подписывать модули и не искать ключи Ubuntu ----------------------
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_ALL=n
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_COMPRESS_NONE=y

# --- нужно образу --------------------------------------------------------
CONFIG_EFI_STUB=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_ZRAM=m
CONFIG_CRYPTO_ZSTD=y

# --- из issue #102 (сон): без этого root port не уходит в D3 --------------
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_CRYPTO_DEV_QCE=m

# --- страховка для сборки с голым defconfig ------------------------------
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_X1E80100=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_APR=m
CONFIG_QRTR=y
CONFIG_MHI_BUS=m
CONFIG_ATH12K=m
CONFIG_DRM_MSM=m
CONFIG_SND_SOC_QCOM=m
CONFIG_BLK_DEV_NVME=y
