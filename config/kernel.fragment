# Фрагмент конфига ядра для Lenovo IdeaPad Slim 5 14Q8X9 (83HL)
# Snapdragon X Plus X1P42100 / Adreno X1-45 / FastConnect 7800
#
# Мержится поверх arch/arm64/configs/defconfig (scripts/kconfig/merge_config.sh).
# Неизвестные символы (переименованные в новых ядрах) просто игнорируются —
# смотрите предупреждения в логе сборки.

# --- общее ---------------------------------------------------------------
CONFIG_LOCALVERSION="-83hl"
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set

# --- Qualcomm X1P/X1E платформа -----------------------------------------
CONFIG_ARCH_QCOM=y
CONFIG_ARM64=y

# clock / power / interconnect
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_CLK_X1E80100_GCC=y
CONFIG_CLK_X1E80100_CAMCC=y
CONFIG_CLK_X1E80100_DISPCC=y
CONFIG_CLK_X1E80100_GPUCC=y
CONFIG_CLK_X1E80100_VIDEOCC=y
CONFIG_CLK_X1E80100_TCSRCC=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_CPR=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_HFPLL=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_X1E80100=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y

# SCM / SMEM / firmware-обмен
CONFIG_QCOM_SCM=y
CONFIG_QCOM_TZMEM=y
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_ICC_BW_MONITOR=y

# remoteproc (ADSP/CDSP/GPU/MPSS) — нужен для Wi-Fi, BT, аудио, GPU
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_APR=y

# pinctrl / GPIO
CONFIG_PINCTRL=y
CONFIG_PINCTRL_X1E80100=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_GPIOLIB=y

# шины
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_OF=y

# PMIC / регуляторы / RTC / watchdog
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_WDT=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_NVMEM_QCOM_QFPROM=y

# PCIe / USB / Type-C
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_TYPEC_QCOM_PMIC=y

# хранилище
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_SCSI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# графика (Adreno X1-45) и консоль
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_EDP=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_PM_DEVFREQ=y

# Wi-Fi FastConnect 7800 (17cb:1107) и Bluetooth (17cb:0111)
CONFIG_ATH12K=m
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
CONFIG_MHI_BUS=y
CONFIG_MHI_BUS_PCI_GENERIC=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y

# ввод
CONFIG_INPUT_EVDEV=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_USB_HID=y
CONFIG_KEYBOARD_HID=y

# звук (на X1E пока частично; включаем каркас)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_USB_AUDIO=m

# ФС и прочее для образа
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_IOMMU_SUPPORT=y
